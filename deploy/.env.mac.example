# =============================================================================
# Mac 端環境變數範本（混合部署）
#
# 用法：複製到專案根目錄的 .env.docker（Mac 那一台），再逐項填值。
#     cp deploy/.env.mac.example .env.docker
#
# 核心概念：Mac 不是一套獨立的系統，它是生產機的「瀏覽器手腳」。
#   - DB 與 Redis 都指向生產機（走 Tailscale）
#   - 只跑 browser 容器與 browser queue worker，不跑 web / vite / mysql / redis
#   - 不要在 Mac 上跑 migrate、不要在 Mac 上跑 default queue
#
# 生產機 vs Mac 的差異（只列不一樣的，其餘照生產機抄）：
#
#   變數                   生產機                    Mac
#   -------------------    ----------------------    --------------------------------
#   DB_HOST                mysql（容器名）            100.x.y.z（生產機 Tailscale IP）
#   REDIS_HOST             redis（容器名）            100.x.y.z（生產機 Tailscale IP）
#   DB_PORT                3306                      3308（生產機對外映射的 port）
#   REDIS_PORT             6379                      6380（生產機對外映射的 port）
#   QUEUE_CONNECTION       redis                     redis  ← 必須同一個，這是兩機協作的關鍵
#   CACHE_STORE            redis                     redis  ← 心跳要寫到共用 Redis
#   BROWSER_SERVICE_URL    （留空）                   http://browser:3031
#   HORIZON_NAME           prod                      mac
#   HORIZON_ENV            （留空 = production）      production-mac
#   APP_ROLE               prod                      mac
#
# ⚠️⚠️ DB_HOST / REDIS_HOST 一定要填 Tailscale 的「IP」（100.x.y.z），不要填
#      MagicDNS 名稱（例如 vps.tailnet-xxxx.ts.net）。
#      原因：這兩個變數是被 Docker 容器裡的 PHP 讀取的，而 Docker Desktop 的容器
#      用的是 Docker 內建的 DNS（127.0.0.11）→ 轉送到 VM 的 resolver，
#      那條路徑上沒有 Tailscale 的 MagicDNS resolver。
#      症狀是 `php artisan tinker` 裡 DB 連線報 getaddrinfo failed，但在 Mac 的
#      terminal 上 `ping vps.tailnet-xxxx.ts.net` 卻是通的 —— 非常容易誤判。
#      查 IP：tailscale ip -4 <生產機 hostname>
# =============================================================================

APP_NAME="AI Video"
APP_ENV=production
APP_KEY=                       # ⚠️ 必須與生產機「完全相同」。不同的話 Mac 解不開
                               #    生產機加密過的資料（encrypted cast / session），
                               #    而錯誤訊息只會說 payload is invalid。
APP_DEBUG=false
APP_URL=https://your-domain.example

# 這台機器的角色。排程會用它決定哪些任務該跑（見 App\Console\Kernel）：
#   mac  → browser:heartbeat（每分鐘）
#   prod → browser:reap-stale（每 10 分鐘）
APP_ROLE=mac

# 顯示在 Filament 心跳卡上的名稱。留空會退回 "mac/<容器 hostname>"，
# 而容器 hostname 是隨機 hash，看不出是哪台。
BROWSER_WORKER_NAME=paul-macbook

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- 生產機的 MySQL（走 Tailscale）-------------------------------------------
# ⚠️ port 是生產機 docker-compose.yml 對外映射的 3308，不是容器內的 3306。
DB_CONNECTION=mysql
DB_HOST=100.64.0.1             # ← 換成 `tailscale ip -4 <vps>` 的結果
DB_PORT=3308
DB_DATABASE=aivideo
DB_USERNAME=aivideo
DB_PASSWORD=                   # 與生產機相同

# --- 生產機的 Redis（走 Tailscale）-------------------------------------------
# ⚠️ 兩台共用同一份 Redis 才能做到「生產機 dispatch、Mac 消費」。
#    這裡填本機 redis 的話，Mac 會對著一個空佇列乾等，而生產機的任務永遠沒人取。
# ⚠️ REDIS_PASSWORD 不是選配：即使在 tailnet 內，Redis 也必須設 requirepass。
#    tailnet 裡任何一台被入侵的裝置都能直連 Redis，而 Redis 無密碼 = 可以塞任意
#    序列化 payload 進 queue = 在生產機上任意執行程式碼。
REDIS_CLIENT=phpredis
REDIS_HOST=100.64.0.1          # ← 同上，換成生產機的 Tailscale IP
REDIS_PORT=6380
REDIS_PASSWORD=                # 與生產機的 requirepass 相同

CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- 瀏覽器服務（只有 Mac 有）-------------------------------------------------
# ⚠️ 生產機這一項必須「留空」：空值時 PlaywrightBrowserAutomation 會立刻失敗，
#    等於一道保險 —— 生產機就算誤取到 browser job 也不會試著開 Chromium
#    （那台機器 2GB RAM，開下去是 OOM 連帶把 MySQL 一起拖死）。
BROWSER_SERVICE_URL=http://browser:3031
BROWSER_SERVICE_TOKEN=         # 自己產一組：openssl rand -hex 32
BROWSER_SERVICE_TIMEOUT=120
BROWSER_SERVICE_CONNECT_TIMEOUT=10

# 反爬設定。⚠️ 這些是帳號風險控管而非效能參數，不要調高。
# 蝦皮封的是帳號，而帳號只能人工 SMS OTP 恢復。
BROWSER_SHOPEE_SCRAPE_PER_HOUR=20
BROWSER_EXTERNAL_IMAGE_PER_HOUR=60
BROWSER_SESSION_CHECK_PER_HOUR=12
BROWSER_WINDOW_START=09:00
BROWSER_WINDOW_END=23:00
BROWSER_WINDOW_TIMEZONE=Asia/Taipei
BROWSER_JITTER_MIN=0.8
BROWSER_JITTER_MAX=3.0
BROWSER_RETRY_DELAYS=10,30,90

# 失敗截圖 / trace 一律丟 S3：browser 容器的 artifacts 是 named volume，
# 容器重建就沒了，而生產機的 Filament 要讀得到這些檔案。
BROWSER_ARTIFACTS_DISK=s3

# Dola 預設不啟用。⚠️ 多帳號輪替刷免費額度是明確的 ToS 違規，
# 且 Dola 只有 Google OAuth 登入 → 自動重登會鎖 Google 帳號。
BROWSER_PROFILES_DOLA=

# --- Horizon ------------------------------------------------------------------
# ⚠️ 兩台機器把 supervisor 註冊到同一份 Redis，名稱必須不同才分得出誰是誰。
HORIZON_NAME=mac
# production-mac 這組只部署 supervisor-browser（supervisor-1 的 maxProcesses=0）。
# 生產機留空 → 吃 production 這組（supervisor-browser 的 maxProcesses=0）。
HORIZON_ENV=production-mac

# --- S3 -----------------------------------------------------------------------
# 與生產機相同。Mac 抓到的圖片直接寫 S3，不經過生產機（省頻寬也省那台機器的磁碟）。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=

# --- 真實 API 開關 -------------------------------------------------------------
# ⚠️⚠️ 這一項在 Mac 上「必須」是 true，否則整個混合架構沒有意義。
#      AppServiceProvider 把 BrowserAutomationContract 綁在 use_real_apis 下：
#      false 時拿到的是 StubBrowserAutomation，Mac 會回傳假資料而不是真的開
#      Chromium 去抓 —— 而且不會有任何錯誤，只會得到「抓到了但內容是假的」商品。
#
#      副作用：這個開關同時打開 fal.ai / Kling / Azure TTS / Remotion。
#      Mac 不消費 default queue（HORIZON_ENV=production-mac 把 supervisor-1 的
#      maxProcesses 設成 0），所以那些 job 不會在 Mac 上跑，不會重複付費。
#      但這也代表：**不要在 Mac 上手動跑 queue:work --queue=default**。
APP_USE_REAL_APIS=true

# 留空的生成類 API key：Mac 不跑那些 job，填了只是多一份外洩面。
# ⚠️ 若之後要在 Mac 上 debug 生成流程，請改用另一份 .env 而不是把 key 放進這裡。
FAL_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
AZURE_SPEECH_KEY=
