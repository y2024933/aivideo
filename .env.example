APP_NAME="AI Video"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aivideo
DB_USERNAME=aivideo
DB_PASSWORD=aivideo

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb

VITE_DEV_SERVER_URL=http://localhost:5174

# ---- API 模式 ----
# false = 使用 stub（開發用），true = 呼叫真實 API
APP_USE_REAL_APIS=false
APP_API_BUDGET_USD=10

# 自動放行 checkpoint（gate 全過才放行）：① 商品資料、② 腳本（預設關）、③ 素材（僅純商品圖）
AUTOPILOT_PRODUCT=true
AUTOPILOT_SCRIPT=false
AUTOPILOT_ASSETS=true

# ---- fal.ai (Flux Kontext 圖片生成) ----

# ---- LLM 寫稿供應商 ----
# gemini（預設，Google AI Studio 免費額度）/ claude（付費，品質較佳）/ stub
SCRIPT_PROVIDER=gemini

# ---- Google Gemini (LLM 自動寫稿，免費 tier) ----
# 從 https://aistudio.google.com/apikey 取得，不需綁信用卡
GEMINI_API_KEY=
# 留空用 config 預設 gemini-flash-latest（alias，會自動跟到最新的 Flash）
GEMINI_MODEL=
GEMINI_TIMEOUT=180
# 免費 tier 不計費，單價留 0 即可；升付費時填實際單價 USD / MTok
GEMINI_COST_IN=0.0
GEMINI_COST_OUT=0.0

# ---- Anthropic Claude (LLM 自動寫稿) ----
# 只有 SCRIPT_PROVIDER=claude（或商品層級指定 claude）時才需要，約 $0.034／支
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT=180
# 單價 USD / MTok，僅用於 llm_cost_usd 記帳，改價時同步更新
ANTHROPIC_COST_IN=5.0
ANTHROPIC_COST_OUT=25.0
ANTHROPIC_COST_CACHE_WRITE=6.25
ANTHROPIC_COST_CACHE_READ=0.5

# ---- 動畫供應商（全域預設）----
# none = 純商品圖 Ken Burns（免費、無 AI 變形風險，預設）
# kling = Kling AI 動畫（$0.21／5 秒／鏡）
# dola = 尚未實作，選到會明確失敗（見 App\Services\Video\DolaAccountPool 的風險警告）
# 商品（products.video_provider）與鏡頭（shots.video_provider）都可逐層覆寫，留空 = 繼承上一層
VIDEO_PROVIDER=none

# ---- Kling AI (影片生成) ----
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ---- Azure TTS (配音，zh-TW 台灣腔) ----
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastasia

# ---- AWS (Remotion Lambda 影片剪接) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---- Remotion Lambda ----
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_REGION=us-east-1

# ---- 蝦皮 ----
SHOPEE_IMAGE_CDN=https://down-tw.img.susercontent.com/file/
SHOPEE_CREATOR_URL=https://creator.shopee.tw/

# ---- 瀏覽器自動化服務（browser/ 的 Fastify + rebrowser-playwright）----
# ⚠️ 生產機務必留空 BROWSER_SERVICE_URL！
#    瀏覽器服務只跑在開發機（docker compose --profile browser up -d）。留空時
#    PlaywrightBrowserAutomation 會立刻回 failed，誤派到生產機的 job 才不會卡在
#    queue 裡等 timeout（卡住的 job 沒有錯誤訊息，最難查）。
#    開發機請填 http://browser:3031
BROWSER_SERVICE_URL=
BROWSER_SERVICE_TOKEN=dev-browser-token
BROWSER_SERVICE_TIMEOUT=120
BROWSER_SERVICE_CONNECT_TIMEOUT=10

# Dola 用的瀏覽器 profile 名稱（逗號分隔）。留空 = 不啟用 Dola。
# ⚠️ 填之前請讀 App\Services\Video\DolaAccountPool 的 class docblock：
#    Dola 只有 Google OAuth 登入（沒有帳密路徑）、絕對不能自動重登（會鎖 Google 帳號），
#    多帳號輪替刷免費額度是明確的 ToS 違規且有連鎖封號風險。
BROWSER_PROFILES_DOLA=

# 每小時抓取上限。⚠️ 這是帳號風險控管，不是效能旋鈕 ——
# 蝦皮封的是帳號，而帳號只能人工 SMS OTP 恢復，請勿調高。
BROWSER_SHOPEE_SCRAPE_PER_HOUR=20
BROWSER_EXTERNAL_IMAGE_PER_HOUR=60
BROWSER_SESSION_CHECK_PER_HOUR=12

# 只在台灣時間這個區間跑（半夜連續抓取是最明顯的機器人特徵）
BROWSER_WINDOW_START=09:00
BROWSER_WINDOW_END=23:00
BROWSER_WINDOW_TIMEZONE=Asia/Taipei
BROWSER_JITTER_MIN=0.8
BROWSER_JITTER_MAX=3.0

# 重試 backoff（秒）。重試只在 PlaywrightBrowserAutomation 內部做，
# ScrapeShopeeProductJob 的 tries 固定為 1，不要雙重重試。
BROWSER_RETRY_DELAYS=10,30,90
BROWSER_ARTIFACTS_DISK=s3

# ---- 混合部署（生產機 + Mac 瀏覽器端）----
# 完整步驟見 deploy/README.md，Mac 端的範本見 deploy/.env.mac.example。
#
# 這台機器的角色。排程靠它決定該跑什麼（見 App\Console\Kernel）：
#   prod → browser:reap-stale（每 10 分鐘，回收 Mac 睡眠時卡死的任務）
#   mac  → browser:heartbeat（每分鐘，生產機唯一的存活訊號）
# ⚠️ 兩台共用同一份 Redis 與 MySQL，不 gate 的話每個排程都會各跑一次。
APP_ROLE=prod

# 顯示在 Filament 心跳卡上的名稱。留空會退回 "<role>/<容器 hostname>"，
# 而容器 hostname 是隨機 hash，看不出是哪台機器。
BROWSER_WORKER_NAME=

# ⚠️ 兩台機器把 supervisor 註冊到同一份 Redis，名稱相同就分不出誰是誰。
HORIZON_NAME=prod
# 決定吃 config/horizon.php 的 environments 哪一組：
#   留空 → production（只部署 supervisor-1，supervisor-browser 的 maxProcesses=0）
#   Mac  → production-mac（只部署 supervisor-browser）
HORIZON_ENV=
