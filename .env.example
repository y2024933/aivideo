APP_NAME="AI Video"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aivideo
DB_USERNAME=aivideo
DB_PASSWORD=aivideo

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb

VITE_DEV_SERVER_URL=http://localhost:5174

# ---- API 模式 ----
# false = 使用 stub（開發用），true = 呼叫真實 API
APP_USE_REAL_APIS=false
APP_API_BUDGET_USD=10

# ---- fal.ai (Flux Kontext 圖片生成) ----
FAL_API_KEY=

# ---- Kling AI (影片生成) ----
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ---- Azure TTS (配音，zh-TW 台灣腔) ----
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastasia

# ---- AWS (Remotion Lambda 影片剪接) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---- Remotion Lambda ----
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_REGION=us-east-1
